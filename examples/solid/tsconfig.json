{
	"compilerOptions": {
		"target": "ESNext",
		"lib": ["ESNext", "DOM"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": true,
		"skipLibCheck": true,
		"jsx": "preserve",
		"jsxImportSource": "@solidjs/web",
		"types": ["vite/client"],
		"noEmit": true
	},
	"include": ["src", ".cxx"]
}
